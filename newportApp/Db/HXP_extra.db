record(bo,"$(P)$(R)MOVE_ALL") {
    field(DESC,"Move all motors")
    field(DTYP,"asynInt32")
    field(ZNAM,"Off")
    field(ONAM,"On")
    field(OUT, "@asyn($(PORT),0)HXP_MOVE_ALL")
}

record(ao,"$(P)$(R)T1") {
    field(DESC,"X target pos")
    field(DTYP,"asynFloat64")
    field(OUT, "@asyn($(PORT),0)HXP_MOVE_ALL_TARGET_X")
    field(PREC,"5")
    field(VAL, "0.0")
